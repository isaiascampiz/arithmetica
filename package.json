    "restore:test": "node scripts/run-ts.cjs scripts/restore-test.ts",
    "cloud:provision": "node scripts/run-ts.cjs scripts/cloud-provision.ts",
    "demo:skills:add": "node scripts/run-ts.cjs scripts/add-skill-ratings.ts",
    "demo:activity:add": "node scripts/run-ts.cjs scripts/add-center-activity.ts",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs",
    "repo:check": "node scripts/repository-check.mjs"
  },
  "dependencies": {
    "@zxing/browser": "0.2.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.55.0",
    "next": "16.4.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
