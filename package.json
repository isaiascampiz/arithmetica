{
  "name": "arithmetica",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/build.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-ts.cjs --test",
    "test:e2e": "node scripts/e2e.mjs",
    "benchmark": "node scripts/run-ts.cjs scripts/benchmark.ts",
    "roster:preview": "node scripts/run-ts.cjs scripts/roster-preview.ts",
    "roster:stage": "node scripts/run-ts.cjs scripts/roster-stage.ts",
    "center:prepare": "node scripts/run-ts.cjs scripts/center-prepare.ts",
    "cloudflare:build": "node scripts/cloudflare-build.mjs",
    "cloudflare:deploy": "node scripts/cloudflare-deploy.mjs",
    "api:deploy": "node scripts/supabase-deploy.mjs",
    "backup:cloud": "node scripts/run-ts.cjs scripts/cloud-backup.ts",
    "test:hosted": "playwright test --config playwright.hosted.config.ts",
    "backup": "node scripts/run-ts.cjs scripts/backup.ts",
    "demo:restore": "node scripts/run-ts.cjs scripts/restore-demo.ts",
    "demo:quick-view": "node scripts/run-ts.cjs scripts/quick-view-demo.ts",
