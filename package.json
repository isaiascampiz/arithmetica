    "@types/react-dom": "19.3.0",
    "deno": "2.9.6",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "wrangler": "4.155.0"
  },
  "description": "Learning center operations for attendance, worksheet preparation, instructor handoffs, and reporting.",
