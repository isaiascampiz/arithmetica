# Default: preserved fictional demo. No real minors' data without authorization.
DEMO_MODE=true
DATA_ADAPTER=local
PRODUCTION_DATA_APPROVED=false
# Set explicitly to staging (synthetic intake only) or production on deployed hosts.
DEPLOYMENT_ENV=local
# Real-data browser dictation stays disabled until provider-specific approval is documented.
DICTATION_PRIVACY_APPROVED=false
DICTATION_APPROVAL_REFERENCE=
# Run on ONE persistent Node server, or call /api/jobs from a secured scheduler.
# V3 closes visits and archives at center closing time; workspace access also catches up.
ENABLE_SCHEDULER=true
JOBS_SECRET=
# Set a random secret of at least 32 characters before sharing across devices.
SESSION_SECRET=
DEMO_OWNER_PASSWORD=
DEMO_INSTRUCTOR_PASSWORD=
DEMO_ASSISTANT_PASSWORD=
# Default persistent file: data/demo-v1.json (never committed)
# Optional fictional attendance samples: see docs/operations.md; never loaded automatically.
DEMO_DATA_PATH=
CENTER_TIMEZONE=America/Los_Angeles
# Optional exact public HTTPS origin when using a reverse proxy.
APP_ORIGIN=
COOKIE_SECURE=false
# Cloud mode: DATA_ADAPTER=supabase, DEMO_MODE=false, explicit organizational approval.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CENTER_ID=
ALLOW_CLOUD_PROVISION=false
# Hosted V1: configure server values through protected deployment tooling, not NEXT_PUBLIC browser variables.
# Supabase supplies SUPABASE_URL/SUPABASE_ANON_KEY/SUPABASE_SERVICE_ROLE_KEY to Edge Functions.
# App-specific Edge secret aliases (see docs/cloudflare.md):
# ARITHMETICA_ENVIRONMENT=staging|production
# ARITHMETICA_DATA_APPROVED=true
# ARITHMETICA_APP_ORIGIN=https://your-app.workers.dev
# ARITHMETICA_CENTER_ID=<existing-center-uuid>
# ARITHMETICA_SESSION_SECRET=<permanent-random-secret>
# ARITHMETICA_JOBS_SECRET=<permanent-random-secret>
# The static proxy uses only API_ORIGIN (config), NEXT_PUBLIC_SUPABASE_ANON_KEY and JOBS_SECRET.
# Optional browser-test port when another test server owns 3100; set in the test shell.
# ARITHMETICA_E2E_PORT=3110
# Browser artifacts default to a unique test-results/runs/<run ID> directory.
# Optional explicit output directory; use a dedicated test-only folder.
# ARITHMETICA_E2E_OUTPUT_DIR=test-results/my-isolated-run
# ARITHMETICA_E2E_DATA_PATH=data/e2e-runs/my-isolated-run/state.json
# Legacy CENTERFLOW_E2E_* aliases remain supported; ARITHMETICA_* takes precedence.
