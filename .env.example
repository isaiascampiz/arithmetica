# Default: preserved fictional demo. No real minors' data without authorization.
DEMO_MODE=true
DATA_ADAPTER=local
PRODUCTION_DATA_APPROVED=false
# Run on ONE persistent Node server, or call /api/jobs from a secured scheduler.
ENABLE_SCHEDULER=true
JOBS_SECRET=
# Set a random secret of at least 32 characters before sharing across devices.
SESSION_SECRET=
DEMO_OWNER_PASSWORD=
DEMO_INSTRUCTOR_PASSWORD=
DEMO_ASSISTANT_PASSWORD=
# Default persistent file: data/demo-v1.json (never committed)
DEMO_DATA_PATH=
CENTER_TIMEZONE=America/Los_Angeles
# Optional exact public HTTPS origin when using a reverse proxy.
APP_ORIGIN=
COOKIE_SECURE=false
# Cloud mode: DATA_ADAPTER=supabase, DEMO_MODE=false, explicit organizational approval.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CENTER_ID=
ALLOW_CLOUD_PROVISION=false
