{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arithmetica-staging",
  "main": "src/server/static-worker.ts",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "data/browser-build/out",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true,
  },
  "vars": { "API_ORIGIN": "https://vnzwfvjjhijdduqcjfks.supabase.co/functions/v1/arithmetica-api" },
  "triggers": { "crons": ["*/15 * * * *"] },
}
